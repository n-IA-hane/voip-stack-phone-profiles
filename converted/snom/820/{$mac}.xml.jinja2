<filter_registrar>off</filter_registrar>
<logon_wizard>off</logon_wizard>
<message_led_other>off</message_led_other>
<user_phone>off</user_phone>
<intercom_enabled>on</intercom_enabled>
{% if ((((((admin_password) is defined and (admin_password) is not none))) is defined and ((((admin_password) is defined and (admin_password) is not none))) is not none) and ((((admin_password) is defined and (admin_password) is not none))) != false and ((((admin_password) is defined and (admin_password) is not none))) != 0 and ((((admin_password) is defined and (admin_password) is not none))) != '' and ((((admin_password) is defined and (admin_password) is not none))) != '0' and ((((admin_password) is defined and (admin_password) is not none))) != [] and ((((admin_password) is defined and (admin_password) is not none))) != {}) %}
