<http_pass perm="">{{ (1 if (admin_password) is sameas true else '' if (admin_password) is sameas false or (admin_password) is none else (admin_password)) }}</http_pass>
{% endif %}
<web_logout_timer>5</web_logout_timer>
{% if ((((((admin_password) is defined and (admin_password) is not none))) is defined and ((((admin_password) is defined and (admin_password) is not none))) is not none) and ((((admin_password) is defined and (admin_password) is not none))) != false and ((((admin_password) is defined and (admin_password) is not none))) != 0 and ((((admin_password) is defined and (admin_password) is not none))) != '' and ((((admin_password) is defined and (admin_password) is not none))) != '0' and ((((admin_password) is defined and (admin_password) is not none))) != [] and ((((admin_password) is defined and (admin_password) is not none))) != {}) %}
<admin_mode_login perm="">{{ (1 if (admin_name) is sameas true else '' if (admin_name) is sameas false or (admin_name) is none else (admin_name)) }}</admin_mode_login>
<admin_mode_password perm="">{{ (1 if (admin_password) is sameas true else '' if (admin_password) is sameas false or (admin_password) is none else (admin_password)) }}</admin_mode_password>
<admin_mode_password_confirm perm="">{{ (1 if (admin_password) is sameas true else '' if (admin_password) is sameas false or (admin_password) is none else (admin_password)) }}</admin_mode_password_confirm>
{% else %}
<admin_mode_password>0000</admin_mode_password>
<admin_mode_password_confirm>0000</admin_mode_password_confirm>
{% endif %}
<language>English</language>
<ntp_server>{{ (1 if (ntp_server_primary) is sameas true else '' if (ntp_server_primary) is sameas false or (ntp_server_primary) is none else (ntp_server_primary)) }}</ntp_server>
<timezone>AUS+10</timezone>
<dst>3600 25.09 02:00:00 04.05 03:00:00</dst>
<tone_scheme>US</tone_scheme>
<ring_sound>Ringer9</ring_sound>
<no_dnd>off</no_dnd>
<call_waiting>on</call_waiting>
<user_realname idx="1">{{ (1 if (user[1]["display_name"]) is sameas true else '' if (user[1]["display_name"]) is sameas false or (user[1]["display_name"]) is none else (user[1]["display_name"])) }}</user_realname>
<user_name idx="1">{{ (1 if (user[1]["user_id"]) is sameas true else '' if (user[1]["user_id"]) is sameas false or (user[1]["user_id"]) is none else (user[1]["user_id"])) }}</user_name>
