{# SPDX-License-Identifier: MPL-1.1
Derived from FusionPBX by Mark J Crane and contributors, pinned provenance.json.
2026-11-11: retain only explicit SIP, DSS, language, LDAP and provisioning fields.
2026-11-13: bounded owned DSS clears and registration disables, no global reset.
2026-11-13: vendor configuration suffixes bc/f for BLF New Call and speed dial.
-#}
<?xml version="1.0" encoding="UTF-8"?>
<sysConf>
<Version>2.0000000000</Version>
{% if lines or retired['lines'] %}<sip>
{% for line in lines %}<line index="{{ line.slot }}">
<PhoneNumber>{{ line.username }}</PhoneNumber>
<DisplayName>{{ line.display_name or physical.name }}</DisplayName>
<RegisterAddr>{{ line.server }}</RegisterAddr>
<RegisterPort>{{ line.port }}</RegisterPort>
<RegisterUser>{{ line.auth_username or line.username }}</RegisterUser>
<RegisterPswd>{{ line.password }}</RegisterPswd>
<RegisterTTL>{{ line.expires or 3600 }}</RegisterTTL>
<EnableReg>1</EnableReg>
<Transport>{{ {'udp':0,'tcp':1,'tls':3}[line.transport] }}</Transport>
{% if line.outbound_proxy %}<ProxyAddr>{{ line.outbound_proxy }}</ProxyAddr>{% endif %}
</line>{% endfor %}{% for slot in retired['lines'] %}<line index="{{ slot }}"><EnableReg>0</EnableReg></line>{% endfor %}
</sip>{% endif %}
{% if keys or retired['keys'] %}<dsskey><internal index="1">
{% for key in keys %}<Fkey index="{{ key.slot }}">
<Type>{{ 2 if key.function == 'line' else 1 }}</Type>
<Value>{% if key.function == 'line' %}SIP{{ key.line }}{% else %}{{ key.subscription_target or key.dial_target }}@{{ key.line }}/{{ 'bc' if key.function in ['blf','queue_login','queue_pause','park'] else 'c' if key.function == 'park_call' else 'f' }}{% endif %}</Value>
<Title>{{ key.label }}</Title>
</Fkey>{% endfor %}{% for slot in retired['keys'] %}<Fkey index="{{ slot }}"><Type>0</Type><Value></Value><Title></Title></Fkey>{% endfor %}
</internal></dsskey>{% endif %}
{% if physical.language or directory.ldap.host %}<__PHONE_PARENT__>
{% if physical.language %}<display><DefaultLanguage>{{ physical.language }}</DefaultLanguage></display>{% endif %}
{% if directory.ldap.host %}<ldap index="1">
<Title>{{ directory.ldap.display_name or 'LDAP' }}</Title>
<Server>{{ directory.ldap.host }}</Server><port>{{ directory.ldap.port }}</port>
<Base>{{ directory.ldap.base_dn }}</Base><Version>3</Version>
<Username>{{ directory.ldap.bind_dn }}</Username><Password>{{ directory.ldap.password }}</Password>
<NameFilter>{{ directory.ldap.name_filter }}</NameFilter>
<NumberFilter>{{ directory.ldap.number_filter }}</NumberFilter>
<NameAttr>{{ directory.ldap.name_attributes }}</NameAttr>
<TelAttr>{{ directory.ldap.number_attributes.split()[0] }}</TelAttr>
<MobileAttr>{{ directory.ldap.number_attributes.split()[1] if directory.ldap.number_attributes.split()|length > 1 else 'mobile' }}</MobileAttr>
<Displayname>{{ directory.ldap.display_attribute|default('displayName') }}</Displayname>
</ldap>{% endif %}
</__PHONE_PARENT__>{% endif %}
{% if provisioning.url %}<ap><FlashServerIP>{{ provisioning.url }}</FlashServerIP></ap>{% endif %}
</sysConf>
