Derived from FusionPBX by Mark J Crane and contributors, pinned provenance.json.
2026-11-11: sparse identity and fkey parameters only; preserve unrelated settings.
2026-11-13: sibling functionKeys, explicit identity and bounded owned-slot retirement.
-#}
<?xml version="1.0" encoding="UTF-8"?>
<settings><phone-settings>
{% for line in lines %}
<user_active idx="{{ line.slot }}" perm="">on</user_active>
<user_realname idx="{{ line.slot }}" perm="">{{ line.display_name or physical.name }}</user_realname>
<user_name idx="{{ line.slot }}" perm="">{{ line.username }}</user_name>
<user_pass idx="{{ line.slot }}" perm="">{{ line.password }}</user_pass>
<user_host idx="{{ line.slot }}" perm="">{{ line.server }}:{{ line.port }};transport={{ line.transport }}</user_host>
<user_expiry idx="{{ line.slot }}" perm="">{{ line.expires or 3600 }}</user_expiry>
{% endfor %}
{% for slot in retired['lines'] %}<user_active idx="{{ slot }}" perm="">off</user_active>{% endfor %}
</phone-settings>{% if keys or retired['keys'] %}<functionKeys>
{% for key in keys %}<fkey idx="{{ key.slot|int - 1 }}" context="{{ key.line }}" label="{{ key.label }}" perm="">{{ 'line' if key.function == 'line' else 'blf' if key.function in ['blf','queue_login','queue_pause','park'] else 'speed' }} {{ key.subscription_target or key.dial_target }}</fkey>{% endfor %}{% for slot in retired['keys'] %}<fkey idx="{{ slot|int - 1 }}" label="" perm="">none</fkey>{% endfor %}
</functionKeys>{% endif %}</settings>
