Derived from FusionPBX by Mark J Crane and contributors, pinned provenance.json.
2026-11-11: first SIP identity only, no global P-values.
-#}
<?xml version="1.0" encoding="UTF-8"?>
<gs_provision version="1"><config version="1">
{% for line in lines %}
<P271>1</P271><P270>{{ line.display_name or physical.name }}</P270>
<P47>{{ line.server }}:{{ line.port }}</P47><P35>{{ line.username }}</P35>
<P36>{{ line.auth_username or line.username }}</P36><P34>{{ line.password }}</P34>
<P3>{{ line.display_name or physical.name }}</P3>
<P183>{{ {'udp':0,'tcp':1,'tls':2}[line.transport] }}</P183>
{% endfor %}
</config></gs_provision>
